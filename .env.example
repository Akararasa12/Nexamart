# API Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Midtrans API (Payment Gateway)
# Gunakan Server/Client Key Sandbox untuk Pengujian, dan Production untuk Live.
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# RajaOngkir API (Ongkos Kirim)
RAJAONGKIR_API_KEY=your-rajaongkir-api-key

# AI Assistant API
# Anda bisa menggunakan GEMINI_API_KEY (Google) atau OPENAI_API_KEY (OpenAI), atau keduanya.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Kredensial Portal Admin (/admin)
# Kata sandi untuk masuk ke Dashboard Admin. Default jika tidak diisi: nexa-admin-2026
ADMIN_PASSWORD=your-custom-admin-password
